<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSV 列数据批量替换工具</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; max-width: 800px; margin: 40px auto; padding: 0 20px; color: #333; line-height: 1.6; }
        h2 { border-bottom: 2px solid #eaecef; padding-bottom: 10px; color: #24292e; }
        .section { background: #f6f8fa; border: 1px solid #e1e4e8; padding: 20px; border-radius: 6px; margin-bottom: 20px; }
        label { font-weight: bold; display: block; margin-bottom: 8px; }
        textarea { width: 100%; height: 150px; padding: 10px; border: 1px solid #d1d5da; border-radius: 4px; box-sizing: border-box; font-family: monospace; }
        .form-group { margin-bottom: 15px; }
        input[type="text"], input[type="file"] { width: 100%; padding: 8px; border: 1px solid #d1d5da; border-radius: 4px; box-sizing: border-box; }
        button { background-color: #2ea44f; color: white; border: none; padding: 12px 20px; font-size: 16px; font-weight: bold; border-radius: 6px; cursor: pointer; width: 100%; }
        button:hover { background-color: #2c974b; }
        #log { white-space: pre-wrap; background: #24292e; color: #f6f8fa; padding: 15px; border-radius: 6px; font-family: monospace; display: block; margin-top: 20px; min-height: 50px; }
    </style>
</head>
<body>

    <h2>📊 CSV 列数据批量替换工具 (保留原名版)</h2>

    <div class="section">
        <label for="newData">1. 粘贴你要替换进去的新数据（一列）：</label>
        <textarea id="newData" placeholder="在这里粘贴复制的一列数据，每行一个..."></textarea>
    </div>

    <div class="section">
        <div class="form-group">
            <label for="columnTarget">2. 要替换 CSV 中的哪一列？</label>
            <input type="text" id="columnTarget" placeholder="输入列名（如: 电话）或 列索引（从0开始，如: 0 表示第一列）" value="0">
            <small style="color: #6a737d;">提示：如果 CSV 有表头，请输入表头文字；如果没有表头，请输入数字索引（0, 1, 2...）。</small>
        </div>
    </div>

    <div class="section">
        <label for="csvFiles">3. 选择需要替换的 CSV 文件（支持多选）：</label>
        <input type="file" id="csvFiles" accept=".csv" multiple>
    </div>

    <button onclick="processFiles()">⚡ 替换并打包下载新 CSV</button>

    <div id="log">📢 系统状态：等待操作...</div>

    <script>
        function logMessage(msg) {
            const logDiv = document.getElementById('log');
            logDiv.innerHTML += '<div>' + msg + '</div>';
        }

        async function processFiles() {
            const logDiv = document.getElementById('log');
            logDiv.innerHTML = ''; // 清空日志
            
            const rawDataText = document.getElementById('newData').value.trim();
            const targetColumn = document.getElementById('columnTarget').value.trim();
            const fileInput = document.getElementById('csvFiles');

            if (!rawDataText) {
                alert('【错误】请先粘贴要替换的新数据！');
                return;
            }
            if (!targetColumn) {
                alert('【错误】请指定要替换的列！');
                return;
            }
            if (fileInput.files.length === 0) {
                alert('【错误】请至少上传一个 CSV 文件！');
                return;
            }

            // 按行切分粘贴的数据
            const replacementList = rawDataText.split(/\r?\n/);
            logMessage(`ℹ️ 已读取剪贴板数据，共 ${replacementList.length} 行。`);

            // 创建一个 Zip 压缩包对象
            const zip = new JSZip();
            let processedCount = 0;

            // 遍历处理每个文件
            for (let i = 0; i < fileInput.files.length; i++) {
                let file = fileInput.files[i];
                logMessage(`⏳ 正在处理文件 (${i+1}/${fileInput.files.length}): ${file.name}...`);
                
                try {
                    const text = await file.text();
                    
                    // 解析 CSV
                    const parsed = Papa.parse(text, { skipEmptyLines: true });
                    let rows = parsed.data;

                    if (rows.length === 0) {
                        logMessage(`⚠️ 文件 ${file.name} 为空，跳过。`);
                        continue;
                    }

                    // 确定目标列的索引
                    let columnIndex = parseInt(targetColumn, 10);
                    let startRow = 0;

                    if (isNaN(columnIndex)) {
                        const headerRow = rows[0];
                        columnIndex = headerRow.indexOf(targetColumn);
                        if (columnIndex === -1) {
                            logMessage(`❌ 错误：在文件 ${file.name} 中未找到列名 "${targetColumn}"，跳过该文件。`);
                            continue;
                        }
                        startRow = 1; // 跳过表头
                    }

                    // 开始替换
                    let replaceCount = 0;
                    for (let j = startRow; j < rows.length; j++) {
                        const replaceIndex = j - startRow;
                        if (replaceIndex < replacementList.length) {
                            if (!rows[j]) rows[j] = [];
                            rows[j][columnIndex] = replacementList[replaceIndex];
                            replaceCount++;
                        }
                    }

                    logMessage(`   └─ ✅ 成功替换 ${replaceCount} 行。已移入打包队列。`);

                    // 重新生成 CSV 字符串 (加上 BOM 头防止 Excel 打开中文乱码)
                    const newCsvString = '\uFEFF' + Papa.unparse(rows);

                    // 将处理好的文件塞入压缩包，【完全保留原文件名 file.name】
                    zip.file(file.name, newCsvString);
                    processedCount++;

                } catch (err) {
                    logMessage(`❌ 异常: 处理文件 ${file.name} 时发生错误 - ${err.message}`);
                }
            }

            if (processedCount > 0) {
                logMessage('📦 正在生成 ZIP 压缩包，请稍候...');
                // 生成并自动触发下载压缩包
                zip.generateAsync({ type: 'blob' }).then(function (content) {
                    const url = URL.createObjectURL(content);
                    const a = document.createElement('a');
                    a.href = url;
                    // 设置下载压缩包的名称，解压后里面的所有 CSV 文件名跟原来一模一样
                    a.download = `替换完成的CSV表格_${new Date().toISOString().slice(0,10)}.zip`;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                    logMessage('🎉 压缩包下载成功！解压即可获得原名文件。');
                });
            } else {
                logMessage('❌ 没有成功处理任何文件。');
            }
        }
    </script>
</body>
</html>
